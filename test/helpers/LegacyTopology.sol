pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";

import {
    ILegacyOracleV1,
    ILegacyProxyAdminV4,
    ILegacyStPROSV1,
    ILegacyYieldVaultFactoryV1,
    ILegacyYieldVaultV1,
    LegacyYieldVaultV1Types
} from "./LegacyInterfaces.sol";

/// @notice Minimal WETH9 surface used by the legacy flows.
interface IWETH9Like {
    function deposit() external payable;
    function withdraw(uint256 wad) external;
    function approve(address guy, uint256 wad) external returns (bool);
    function transfer(address dst, uint256 wad) external returns (bool);
    function balanceOf(address account) external view returns (uint256);
    function allowance(address owner, address spender) external view returns (uint256);
    function totalSupply() external view returns (uint256);
    function name() external view returns (string memory);
    function symbol() external view returns (string memory);
    function decimals() external view returns (uint8);
}

/// @title LegacyTopology
/// @notice Builds the deployed (legacy) protocol topology from *recorded* bytecode:
///         OZ v4 ProxyAdmin + TransparentUpgradeableProxy, the live V1 (mainnet) and
///         V3 (testnet) implementations, and the real WPROS runtime read from chain.
/// @dev Bytecode comes from test/fixtures/legacy/<chain>/<name>.json, generated by
///      tools/release/fixtures.py from deployments/ and checked against on-chain code at
///      the pinned blocks in snapshots/deployed/pins.json. Nothing here compiles or uses
///      the current contracts/ sources. Every deployment asserts that the resulting
///      runtime equals both the recorded runtime and the on-chain code.
abstract contract LegacyTopology is Test {
    bytes32 internal constant EIP1967_IMPLEMENTATION_SLOT =
        0x360894a13ba1a3210667c828492db98dca3e2076cc3735a920a3ca505d382bbc;
    bytes32 internal constant EIP1967_ADMIN_SLOT = 0xb53127684a568b3173ae13b9f8a6016e243e63b6e8ee1178d6a717850b5d6103;
    /// @dev OZ v5 ERC-7201 `openzeppelin.storage.Initializable`.
    bytes32 internal constant INITIALIZABLE_SLOT = 0xf0c57e16840df040f15088dc2f81fe391c3923bec73e23a9662efc9c229c6a00;

    /// @dev Token names passed by the recorded mainnet StPROS proxy deployment (argsData).
    string internal constant STPROS_NAME = "Faroo Staked PROS";
    string internal constant STPROS_SYMBOL = "stPROS";

    struct Fixture {
        bytes creationCode;
        bytes runtimeCode;
        bytes32 runtimeKeccak;
        bytes32 onchainCodeKeccak;
    }

    struct StorageWord {
        bytes32 slot;
        bytes32 value;
    }

    /// @notice Mainnet V1 core: StPROS and Oracle behind v4 TUPs, one v4 ProxyAdmin, real WPROS.
    struct LegacyV1 {
        address owner;
        address wpros;
        address proxyAdmin;
        address stPROSImpl;
        address oracleImpl;
        ILegacyStPROSV1 stPROS;
        ILegacyOracleV1 oracle;
    }

    /// @notice Mainnet V1 vault side: factory behind a v4 TUP, beacon, recorded vault implementation.
    struct LegacyVaultsV1 {
        address factoryImpl;
        ILegacyYieldVaultFactoryV1 factory;
        address beacon;
        address vaultImpl;
    }

    // ------------------------------------------------------------------ fixtures

    function _fixtureJson(string memory chain, string memory name) internal view returns (string memory) {
        return vm.readFile(string.concat(vm.projectRoot(), "/test/fixtures/legacy/", chain, "/", name, ".json"));
    }

    function _fixture(string memory chain, string memory name) internal view returns (Fixture memory f) {
        string memory json = _fixtureJson(chain, name);
        f.creationCode = vm.parseJsonBytes(json, ".creationCode");
        f.runtimeCode = vm.parseJsonBytes(json, ".runtimeCode");
        f.runtimeKeccak = vm.parseJsonBytes32(json, ".runtimeKeccak");
        f.onchainCodeKeccak = vm.parseJsonBytes32(json, ".onchain.codeKeccak");
        require(keccak256(f.runtimeCode) == f.runtimeKeccak, "LegacyTopology: fixture runtime hash");
        require(f.runtimeKeccak == f.onchainCodeKeccak, "LegacyTopology: recorded runtime != on-chain code");
    }

    function _create(bytes memory creationCode, bytes memory args) internal returns (address deployed) {
        bytes memory initCode = abi.encodePacked(creationCode, args);
        assembly ("memory-safe") {
            deployed := create(0, add(initCode, 0x20), mload(initCode))
        }
        require(deployed != address(0), "LegacyTopology: create failed");
    }

    /// @notice Deploy a recorded implementation from its recorded creation code (the
    ///         constructor runs `_disableInitializers`), and check its runtime identity.
    function _deployRecorded(string memory chain, string memory name) internal returns (address deployed) {
        Fixture memory f = _fixture(chain, name);
        deployed = _create(f.creationCode, "");
        require(keccak256(deployed.code) == f.runtimeKeccak, "LegacyTopology: deployed runtime != recorded");
        vm.label(deployed, string.concat(chain, ".", name));
    }

    /// @notice For recorded runtimes above the EIP-170 limit (testnet YieldVaultFactory, 36,576
    ///         bytes; Pharos testnet accepted it): etch the runtime and reproduce the
    ///         constructor's only effect, `_disableInitializers()`.
    function _etchRecorded(string memory chain, string memory name) internal returns (address deployed) {
        Fixture memory f = _fixture(chain, name);
        deployed = makeAddr(string.concat("legacy.", chain, ".", name));
        vm.etch(deployed, f.runtimeCode);
        vm.store(deployed, INITIALIZABLE_SLOT, bytes32(uint256(type(uint64).max)));
        vm.label(deployed, string.concat(chain, ".", name));
    }

    /// @notice Place the real WPROS runtime at its real address, with its static storage
    ///         (name, symbol, decimals) as read on chain at the pinned block.
    function _etchWPROS(string memory chain) internal returns (address wpros) {
        string memory json = _fixtureJson(chain, "WPROS");
        wpros = vm.parseJsonAddress(json, ".address");
        bytes memory runtime = vm.parseJsonBytes(json, ".runtimeCode");
        require(keccak256(runtime) == vm.parseJsonBytes32(json, ".runtimeKeccak"), "LegacyTopology: WPROS hash");
        vm.etch(wpros, runtime);
        StorageWord[] memory words = abi.decode(vm.parseJson(json, ".staticStorage"), (StorageWord[]));
        for (uint256 i = 0; i < words.length; i++) {
            vm.store(wpros, words[i].slot, words[i].value);
        }
        vm.label(wpros, string.concat(chain, ".WPROS"));
    }

    function _deployProxyAdminV4(string memory chain, address owner) internal returns (address admin) {
        admin = _create(_fixture(chain, "ProxyAdmin_V4").creationCode, abi.encode(owner));
        vm.label(admin, string.concat(chain, ".ProxyAdmin"));
    }

    function _deployTransparentProxyV4(string memory chain, address implementation, address admin, bytes memory data)
        internal
        returns (address proxy)
    {
        Fixture memory f = _fixture(chain, "TransparentUpgradeableProxy_V4");
        proxy = _create(f.creationCode, abi.encode(implementation, admin, data));
        require(keccak256(proxy.code) == f.runtimeKeccak, "LegacyTopology: proxy runtime != recorded");
    }

    function _implementationOf(address proxy) internal view returns (address) {
        return address(uint160(uint256(vm.load(proxy, EIP1967_IMPLEMENTATION_SLOT))));
    }

    function _adminOf(address proxy) internal view returns (address) {
        return address(uint160(uint256(vm.load(proxy, EIP1967_ADMIN_SLOT))));
    }

    function _initializedVersion(address target) internal view returns (uint64) {
        return uint64(uint256(vm.load(target, INITIALIZABLE_SLOT)));
    }

    // ------------------------------------------------------------------ mainnet V1

    /// @notice Mainnet V1 core as deployed: Oracle and StPROS proxies initialized with the
    ///         recorded calldata shape, then `StPROS.setOracle(oracle)` by the owner.
    /// @dev Mainnet's StPROS proxy was initialized through an earlier implementation
    ///      (deployments/mainnet/StPROS.json) and later upgraded to `0xc096…`; here the live
    ///      implementation runs `initialize` directly. Both leave `_initialized == 1`.
    function _deployMainnetV1(address owner) internal returns (LegacyV1 memory t) {
        t.owner = owner;
        t.wpros = _etchWPROS("mainnet");
        t.proxyAdmin = _deployProxyAdminV4("mainnet", owner);
        t.oracleImpl = _deployRecorded("mainnet", "Oracle_V1");
        t.stPROSImpl = _deployRecorded("mainnet", "StPROS_V1");
        t.oracle = ILegacyOracleV1(
            _deployTransparentProxyV4(
                "mainnet", t.oracleImpl, t.proxyAdmin, abi.encodeCall(ILegacyOracleV1.initialize, (owner))
            )
        );
        t.stPROS = ILegacyStPROSV1(
            payable(
                _deployTransparentProxyV4(
                    "mainnet",
                    t.stPROSImpl,
                    t.proxyAdmin,
                    abi.encodeCall(ILegacyStPROSV1.initialize, (t.wpros, owner, STPROS_NAME, STPROS_SYMBOL))
                )
            )
        );
        vm.label(address(t.oracle), "mainnet.Oracle(proxy)");
        vm.label(address(t.stPROS), "mainnet.StPROS(proxy)");
        vm.prank(owner);
        t.stPROS.setOracle(address(t.oracle));
    }

    /// @notice Mainnet V1 vault side as deployed: factory proxy `initialize(owner)` (which
    ///         creates the beacon around an embedded YieldVault), then
    ///         `upgradeBeaconTo(recorded YieldVault)` as deploy/YieldVaultImplementation.ts does.
    function _deployMainnetVaultsV1(LegacyV1 memory core) internal returns (LegacyVaultsV1 memory v) {
        v.factoryImpl = _deployRecorded("mainnet", "YieldVaultFactory_V1");
        v.factory = ILegacyYieldVaultFactoryV1(
            _deployTransparentProxyV4(
                "mainnet",
                v.factoryImpl,
                core.proxyAdmin,
                abi.encodeCall(ILegacyYieldVaultFactoryV1.initialize, (core.owner))
            )
        );
        v.vaultImpl = _deployRecorded("mainnet", "YieldVault_V1");
        vm.prank(core.owner);
        v.factory.upgradeBeaconTo(v.vaultImpl);
        v.beacon = v.factory.beacon();
        vm.label(address(v.factory), "mainnet.YieldVaultFactory(proxy)");
    }

    // ------------------------------------------------------------------ V1 user flows

    function _v1DepositWithPROS(LegacyV1 memory t, address user, uint256 amount) internal returns (uint256 shares) {
        vm.deal(user, user.balance + amount);
        vm.prank(user);
        shares = t.stPROS.depositWithPROS{value: amount}();
    }

    function _v1DepositWPROS(LegacyV1 memory t, address user, uint256 amount) internal returns (uint256 shares) {
        vm.deal(user, user.balance + amount);
        vm.startPrank(user);
        IWETH9Like(t.wpros).deposit{value: amount}();
        IWETH9Like(t.wpros).approve(address(t.stPROS), amount);
        shares = t.stPROS.deposit(amount, user);
        vm.stopPrank();
    }

    function _v1Redeem(LegacyV1 memory t, address user, uint256 shares) internal returns (uint256 assets) {
        vm.prank(user);
        assets = t.stPROS.redeem(shares, user, user);
    }

    function _v1ClaimToPROS(LegacyV1 memory t, address user) internal returns (uint256 amount) {
        vm.prank(user);
        amount = t.stPROS.withdrawCompleteToPROS();
    }

    /// @notice A round shaped like mainnet vault 001 (settle timelock 600 s, no fee, no loss).
    function _v1RoundParams(uint256 openWindow, uint256 lockDuration, uint256 cap)
        internal
        pure
        returns (LegacyYieldVaultV1Types.RoundParams memory)
    {
        return LegacyYieldVaultV1Types.RoundParams({
            openWindow: openWindow,
            lockDuration: lockDuration,
            settleTimelockWindow: 600,
            roundCap: cap,
            perAddressCap: 0,
            minSubscription: 1 ether,
            performanceFeeBps: 0,
            maxLossBps: 0,
            openedAt: 0
        });
    }

    function _createVaultV1(
        LegacyVaultsV1 memory v,
        LegacyV1 memory core,
        address admin,
        address counterparty,
        LegacyYieldVaultV1Types.RoundParams memory firstRound
    ) internal returns (ILegacyYieldVaultV1 vault) {
        vm.startPrank(core.owner);
        v.factory.addCounterpartyToWhitelist(counterparty);
        vault = ILegacyYieldVaultV1(
            v.factory.createYieldVault(
                LegacyYieldVaultV1Types.InitParams({
                    asset: address(core.stPROS),
                    factory: address(v.factory),
                    admin: admin,
                    counterparty: counterparty,
                    feeRecipient: counterparty,
                    name: "Faroo Vault",
                    symbol: "fVLT",
                    firstRound: firstRound
                })
            )
        );
        vm.stopPrank();
    }
}
