# Native outputs (execution belongs in isolated exports)
/cache
/out
/cache_forge
__pycache__/
.DS_Store

# Existing local installation / research data, excluded from native exports
/node_modules
/.pnpm-store/
/tools/release/.cache/

# Protected environment material
.env
.env.*

# Preserve reviewed historical snapshots while ignoring cheatcode outputs
/snapshots/*
!/snapshots/README.md
!/snapshots/abi/
!/snapshots/storage/
!/snapshots/deployed/
!/snapshots/bytecode.json
!/snapshots/capabilities.json
!/snapshots/gas.json

# Owner-local Agent configuration (kept on the owner's machine, never exported)
/.claude/
/AGENTS.md
/AGENT.md
